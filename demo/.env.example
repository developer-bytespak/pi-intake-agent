# Copy to .env.local for local work, or paste these into the Vercel dashboard
# for a deploy. Nothing here is secret until you fill it in. Once you do, never
# commit the filled file. .env and .env.local are gitignored.
#
# The demo runs with every single one of these blank. Postgres falls back to
# PGlite, Lawmatics falls back to the mock pipeline, texts and e-sign fall back
# to previews on screen, and the web form records the lead and tasks intake
# instead of dialing. Fill them in as each service is ready.

# Postgres connection string. OPTIONAL locally, REQUIRED on Vercel, because
# serverless functions do not share an embedded database. Neon works well.
DATABASE_URL=

# Where PGlite keeps its files when DATABASE_URL is unset. Defaults to ./.pgdata.
PGLITE_DIR=./.pgdata

# SECRET. Retell dashboard, API Keys. push-demo-config.ts authenticates with
# it, both webhook routes verify the x-retell-signature HMAC with it, and the
# web form uses it to place the outbound call.
RETELL_API_KEY=

# Public key for the browser call widget. Safe to ship to the browser.
NEXT_PUBLIC_RETELL_PUBLIC_KEY=

# The agent id. Printed by: npm run push:retell
NEXT_PUBLIC_RETELL_AGENT_ID=

# A phone number bought in Retell and bound to this agent, in E.164. When set,
# a web form submission is dialed back by the agent within seconds, which is
# the speed to lead scene. Leave blank and the form records, texts and tasks.
RETELL_FROM_NUMBER=

# The same number, shown on the demo page so the firm can dial it from a mobile.
NEXT_PUBLIC_DEMO_PHONE_NUMBER=

# Set to true to pretend it is after hours regardless of the clock, so the
# night intake scene works at two in the afternoon.
DEMO_FORCE_AFTER_HOURS=true

# Accept unsigned webhooks. Keep it false for a real demo.
ALLOW_UNSIGNED_WEBHOOKS=false

# Where the after hours intake page is texted. Use your own mobile in E.164 so
# you can hold the phone up in the room. Falls back to a dummy number.
DEMO_INTAKE_NUMBER=

# SECRET. A Lawmatics API token for the firm. Leave blank to stay on the mock.
LAWMATICS_TOKEN=
# mock, live, or blank. Blank means auto: live when a token is present.
LAWMATICS_MODE=mock
# Pipeline stage ids differ per firm: "new_lead:123,qualified:124,attorney_review:125,retainer_sent:126,signed:127"
LAWMATICS_STAGE_MAP=
LAWMATICS_INTAKE_USER_ID=
LAWMATICS_ATTORNEY_USER_ID=

# SECRET. Twilio, all three or the SMS layer stays in preview mode.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# An e-sign provider key (DocuSign, Dropbox Sign, or Lawmatics e-sign). Blank
# keeps the envelope as a preview on screen.
ESIGN_API_KEY=

# ---------------------------------------------------------------------------
# Sign-in and tenancy (phase 0). The public demo at / needs none of these.
# ---------------------------------------------------------------------------

# Clerk, one application per product. Create it at https://dashboard.clerk.com,
# then under User & Authentication > Restrictions set sign-up mode to
# Restricted so accounts only come from invitations. Both keys blank means
# /app and /admin are closed and the public demo still works.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# SECRET.
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/app
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/app

# Our own team, comma separated. These addresses can open /admin, create
# customers, send invitations and open any workspace. Everyone else who signs
# in only sees the workspace they were invited to.
PLATFORM_ADMIN_EMAILS=

# Development only, ignored in production and ignored when Clerk keys exist:
# treat every request as this signed-in email, so /app and /admin can be
# worked on before the Clerk application is created. Add the same address to
# PLATFORM_ADMIN_EMAILS to reach the admin console.
AUTH_DEV_USER=
